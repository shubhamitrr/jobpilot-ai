# ==========================================================
# JobPilot AI — Environment Configuration
# Copy this file to backend/.env and fill in real values.
# Never commit a real .env file with secrets.
# ==========================================================

# --- Core ---
ENV=development
DEBUG=true

# --- Database (SQLite by default; swap for Postgres later) ---
DATABASE_URL=sqlite:///./jobpilot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/jobpilot

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI / LLM (required for resume analysis, matching explanations, assistant) ---
# Get a key from https://console.anthropic.com/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Job Providers (optional but recommended for real, non-demo jobs) ---
# Remotive requires no key and is enabled by default (remote jobs only).
# Adzuna (https://developer.adzuna.com/) requires a free app id/key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- SMTP (optional, for Daily Job Agent email reports) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Uploads ---
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=5

# --- Demo mode ---
ALLOW_DEMO_MODE=true
